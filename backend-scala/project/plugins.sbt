// Play Framework plugin
addSbtPlugin("com.typesafe.play" % "sbt-plugin" % "2.9.0")

// Assembly plugin for creating fat JARs
addSbtPlugin("com.eed3si9n" % "sbt-assembly" % "2.1.5")

// Scalafmt for code formatting
